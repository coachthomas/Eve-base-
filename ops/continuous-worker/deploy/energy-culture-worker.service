[Unit]
Description=Energy Culture continuous implementation worker
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=ecworker
Group=ecworker
WorkingDirectory=/opt/energy-culture
EnvironmentFile=/etc/energy-culture-worker.env
ExecStart=/usr/bin/python3 /opt/energy-culture/ops/continuous-worker/worker.py run --root /opt/energy-culture --state /var/lib/energy-culture-worker
Restart=on-failure
RestartSec=10
TimeoutStopSec=150
StateDirectory=energy-culture-worker
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/energy-culture/apps/lead-discovery /opt/energy-culture/docs/lead-runner /var/lib/energy-culture-worker
MemoryMax=512M
TasksMax=32

[Install]
WantedBy=multi-user.target
